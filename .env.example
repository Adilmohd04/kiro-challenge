# SentinelNow — ServiceNow connection (example)
#
# Copy this file to `.env` and fill in real values for a LIVE instance:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. These values are read only
# from the environment by ServiceNowConfig.from_env(); SN_PASSWORD is held as a
# pydantic SecretStr and is never logged, printed, or written to the audit log.
#
# For the default mock mode you do NOT need these — leave SENTINELNOW_MODE=mock.

# Run mode: "mock" (in-memory, no instance needed) or "live" (uses the vars below).
SENTINELNOW_MODE=mock

# ServiceNow instance base URL, e.g. https://dev12345.service-now.com
SN_INSTANCE=

# Instance user with the roles needed for the Table API operations you allow.
SN_USER=

# Password / token for SN_USER. Keep this secret. Never commit the real .env.
SN_PASSWORD=
